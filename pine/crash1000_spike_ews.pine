//@version=6
// ============================================================================
//  CRASH 1000 SPIKE EARLY-WARNING SYSTEM  (C1000 Spike EWS)
//  Instrument : Deriv CRASH 1000 INDEX        Default timeframe : 1 minute
//  Type       : Indicator only (no orders, no automated trading)
//
//  - Multi-factor weighted detection engine (10 factors)
//  - Three signal levels: GREEN normal / YELLOW spike watch / RED high alert
//  - Confirmed (bar-close) signals never repaint; live-bar warnings are shown
//    separately and marked "provisional"
//  - No lookahead: the higher-timeframe request uses the previous HTF bar
//    with lookahead_on (standard non-repainting pattern)
//  - Built-in historical evaluation: hits, false warnings, misses, lead time,
//    precision, recall and LIFT versus the random base rate
//
//  IMPORTANT: Crash 1000 is a synthetic index driven by a random number
//  generator (on average one spike per ~1000 ticks). Spike timing is
//  probabilistic, not a countdown. This tool estimates conditions and
//  measures its own track record; it does not guarantee prediction.
// ============================================================================
indicator("CRASH 1000 Spike Early-Warning System", shorttitle = "C1000 Spike EWS", overlay = true, max_labels_count = 100, max_bars_back = 500)

// ───────────────────────────── INPUT GROUPS ─────────────────────────────────
const string G_DET  = "1. Detection Engine"
const string G_LEN  = "2. Lookbacks"
const string G_SPK  = "3. Spike Confirmation"
const string G_WGT  = "4. Factor Weights"
const string G_MTF  = "5. Multi-Timeframe Confirmation"
const string G_VIS  = "6. Signals & Visuals"
const string G_DSH  = "7. Dashboard"
const string G_ALR  = "8. Alerts"
const string G_EVL  = "9. Historical Evaluation"

// 1. Detection engine
detSens    = input.float(1.0, "Detection sensitivity", minval = 0.25, maxval = 3.0, step = 0.05, group = G_DET, tooltip = "Scales the composite score. Higher = scores rise faster = more signals.")
earlySens  = input.float(1.0, "Early-warning sensitivity", minval = 0.5, maxval = 2.0, step = 0.05, group = G_DET, tooltip = "Lowers the SPIKE WATCH threshold and the number of aligned factors required for a HIGH ALERT. 1.0 = neutral.")
minProb    = input.int(50, "Minimum score for SPIKE WATCH (yellow)", minval = 5, maxval = 95, group = G_DET)
redProb    = input.int(70, "Minimum score for HIGH SPIKE ALERT (red)", minval = 10, maxval = 99, group = G_DET)
minFactors = input.int(4, "Aligned factors required for HIGH ALERT", minval = 1, maxval = 10, group = G_DET)
factorOn   = input.float(0.5, "Factor counts as 'aligned' at", minval = 0.1, maxval = 0.95, step = 0.05, group = G_DET)
smoothLen  = input.int(2, "Score smoothing (EMA bars, 1 = off)", minval = 1, maxval = 10, group = G_DET)

// 2. Lookbacks
momLen     = input.int(14, "Momentum lookback", minval = 3, maxval = 100, group = G_LEN)
volLen     = input.int(50, "Volatility / statistics lookback", minval = 10, maxval = 300, group = G_LEN)
structLen  = input.int(30, "Structure / recent-high lookback", minval = 5, maxval = 200, group = G_LEN)
runNorm    = input.int(12, "Up-run length treated as 'extended'", minval = 3, maxval = 100, group = G_LEN)

// 3. Spike confirmation
spikeMult  = input.float(4.0, "Spike confirmation threshold (x baseline range)", minval = 1.5, maxval = 50.0, step = 0.25, group = G_SPK, tooltip = "A bar is a confirmed spike when its drop (from max(open, prev close) to close) is at least this multiple of the robust baseline bar range (75th percentile of true range). Tune until the dashboard's 'Mean spike interval' matches the instrument (~16-17 bars on 1m for Crash 1000).")
cooldown   = input.int(3, "Post-spike cooldown (bars, no warnings)", minval = 0, maxval = 50, group = G_SPK)

// 4. Weights
wMom    = input.float(1.2, "W1 Momentum & acceleration", minval = 0.0, maxval = 5.0, step = 0.1, group = G_WGT)
wRun    = input.float(1.0, "W2 Consecutive up-moves / exhaustion", minval = 0.0, maxval = 5.0, step = 0.1, group = G_WGT)
wCandle = input.float(0.8, "W3 Candle body & wick", minval = 0.0, maxval = 5.0, step = 0.1, group = G_WGT)
wVol    = input.float(0.8, "W4 Volatility compression / expansion", minval = 0.0, maxval = 5.0, step = 0.1, group = G_WGT)
wTick   = input.float(0.5, "W5 Tick volume (if available)", minval = 0.0, maxval = 5.0, step = 0.1, group = G_WGT)
wStruct = input.float(1.0, "W6 Short-term structure", minval = 0.0, maxval = 5.0, step = 0.1, group = G_WGT)
wDist   = input.float(1.0, "W7 Stretch / distance from highs", minval = 0.0, maxval = 5.0, step = 0.1, group = G_WGT)
wAbn    = input.float(0.7, "W8 Abnormal movement", minval = 0.0, maxval = 5.0, step = 0.1, group = G_WGT)
wStat   = input.float(0.6, "W9 Statistical hazard (empirical)", minval = 0.0, maxval = 5.0, step = 0.1, group = G_WGT)
wMtf    = input.float(0.8, "W10 Multi-timeframe confirmation", minval = 0.0, maxval = 5.0, step = 0.1, group = G_WGT)

// 5. MTF
useMtf  = input.bool(true, "Use higher-timeframe confirmation", group = G_MTF)
htfTf   = input.timeframe("5", "Confirmation timeframe", group = G_MTF, tooltip = "Must be higher than the chart timeframe, otherwise the factor is ignored. Uses the last CLOSED HTF bar only (no repaint).")

// 6. Visuals
showWatch = input.bool(true, "Show SPIKE WATCH markers (yellow)", group = G_VIS)
showAlert = input.bool(true, "Show HIGH SPIKE ALERT arrows (red)", group = G_VIS)
showSpike = input.bool(true, "Show confirmed spike markers", group = G_VIS)
showLive  = input.bool(true, "Show provisional live-bar label", group = G_VIS)
showBg    = input.bool(true, "Tint background by signal level", group = G_VIS)

// 7. Dashboard
showDash  = input.bool(true, "Show dashboard", group = G_DSH)
dashPosIn = input.string("Top Right", "Position", options = ["Top Right", "Top Left", "Bottom Right", "Bottom Left", "Middle Right"], group = G_DSH)
dashSzIn  = input.string("Small", "Text size", options = ["Tiny", "Small", "Normal"], group = G_DSH)
showEval  = input.bool(true, "Show historical evaluation panel", group = G_DSH)

// 8. Alerts
useAlertFn = input.bool(true, "Enable alert() messages (use 'Any alert() function call')", group = G_ALR)
alertMode  = input.string("Bar close (confirmed)", "alert() timing", options = ["Bar close (confirmed)", "Live (provisional, earliest)"], group = G_ALR)
alertWatch = input.bool(true, "Alert: potential spike developing", group = G_ALR)
alertRed   = input.bool(true, "Alert: high-probability spike warning", group = G_ALR)
alertSpike = input.bool(true, "Alert: confirmed downward spike", group = G_ALR)

// 9. Evaluation
evalWin   = input.int(5, "Evaluation window (bars after warning)", minval = 1, maxval = 100, group = G_EVL, tooltip = "A warning counts as correct if a confirmed spike occurs within this many bars after it starts. A spike counts as caught if a warning was active in this many bars before it.")
hazBucket = input.int(5, "Hazard age bucket size (bars)", minval = 1, maxval = 50, group = G_EVL)

// ───────────────────────────── HELPERS ──────────────────────────────────────
clamp01(float x) =>
    float v = nz(x)
    math.max(0.0, math.min(1.0, v))

zScore(float src, int len) =>
    float m = ta.sma(src, len)
    float s = ta.stdev(src, len)
    s > 0 ? (src - m) / s : 0.0

pct(float x) =>
    na(x) ? "—" : str.tostring(x * 100.0, "0.0") + "%"

num(float x, string f) =>
    na(x) ? "—" : str.tostring(x, f)

// Higher-timeframe "pressure" (position in range, up-bar ratio, RSI)
htfPressure() =>
    float hh  = ta.highest(high, 10)
    float ll  = ta.lowest(low, 10)
    float pos = hh > ll ? (close - ll) / (hh - ll) : 0.5
    float upr = math.sum(close > close[1] ? 1.0 : 0.0, 10) / 10.0
    float r   = ta.rsi(close, 14)
    0.4 * clamp01(pos) + 0.3 * clamp01((upr - 0.5) / 0.5) + 0.3 * clamp01((r - 55.0) / 25.0)

// Historical evaluation of one signal level (state is kept per call site)
evalLevel(bool active, bool startEv, bool spikeEv, int win) =>
    var int   warns    = 0
    var int   hits     = 0
    var int   falses   = 0
    var float leadSum  = 0.0
    var int   detected = 0
    var int   missed   = 0
    var int   openBar  = -1
    float actSum       = math.sum(active ? 1.0 : 0.0, win)
    bool  warnedBefore = nz(actSum[1]) > 0
    if barstate.isconfirmed
        // resolve an open warning window
        if openBar >= 0
            if spikeEv and bar_index > openBar
                hits    += 1
                leadSum += bar_index - openBar
                openBar := -1
            else if bar_index - openBar >= win
                falses  += 1
                openBar := -1
        // open a new warning window (overlapping warnings are merged)
        if startEv and openBar < 0
            warns   += 1
            openBar := bar_index
        // spike-side accounting (recall)
        if spikeEv
            if warnedBefore
                detected += 1
            else
                missed += 1
    [warns, hits, falses, leadSum, detected, missed]

// ───────────────────────────── BAR STATE ────────────────────────────────────
bool liveBar = barstate.isrealtime and not barstate.isconfirmed

// ───────────────────────────── SPIKE DETECTION (CONFIRMATION) ───────────────
float prevClose  = nz(close[1], open)
float trv        = ta.tr(true)
float baseTRraw  = ta.percentile_nearest_rank(trv, volLen, 75)
float baseTR     = math.max(nz(baseTRraw[1], trv), syminfo.mintick)   // previous bars only

float dropClose  = math.max(0.0, math.max(open, prevClose) - close)
float dropLow    = math.max(0.0, math.max(open, prevClose) - low)
float spikeLevel = spikeMult * baseTR
bool  spikeCond  = dropClose >= spikeLevel                 // final at bar close
bool  spikeTouch = dropLow >= spikeLevel                   // intrabar extreme
bool  spikeC     = spikeCond and barstate.isconfirmed      // CONFIRMED spike
bool  spikeLive  = liveBar and spikeTouch                  // provisional, in progress
int   spikeInt   = spikeCond ? 1 : 0

// Spike memory (values from PREVIOUS bars at this point)
var int   lastSpikeBar  = -1
var int   lastSpikeTime = 0
var float lastSpikeSize = 0.0
var float lastSpikeX    = 0.0
var int   spikeCount    = 0
var int   intervalN     = 0
var float intervalSum   = 0.0
var float intervalSq    = 0.0

int  ageBars    = lastSpikeBar >= 0 ? bar_index - lastSpikeBar : -1
bool inCooldown = ageBars >= 0 and ageBars <= cooldown

// Spike-free series for statistics
float chg      = close - prevClose
float cleanChg = spikeCond ? 0.0 : chg
float trClean  = spikeCond ? baseTR : trv

// ───────────────────────────── FACTOR 1: MOMENTUM & ACCELERATION ────────────
float cleanRoc = math.sum(cleanChg, momLen)
float rocZ     = zScore(cleanRoc, volLen)
float velFast  = ta.ema(cleanChg, 3)
float velSlow  = ta.ema(cleanChg, momLen)
float chgSd    = ta.stdev(cleanChg, volLen)
float decel    = velSlow > 0 and chgSd > 0 ? (velSlow - velFast) / chgSd : 0.0
float fMom     = 0.6 * clamp01((rocZ - 0.5) / 2.0) + 0.4 * clamp01(decel * 2.0)

// ───────────────────────────── FACTOR 2: CONSECUTIVE UP-MOVES ───────────────
var int upRun = 0
if close > prevClose
    upRun += 1
else if close < prevClose
    upRun := 0
float upRatio = math.sum(close > prevClose ? 1.0 : 0.0, momLen) / momLen
float fRun    = 0.6 * clamp01(float(upRun) / runNorm) + 0.4 * clamp01((upRatio - 0.5) / 0.5)

// ───────────────────────────── FACTOR 3: CANDLE BODY & WICK ─────────────────
float body       = math.abs(close - open)
float rng        = high - low
float upperWick  = high - math.max(open, close)
float lowerWick  = math.min(open, close) - low
float bodyClean  = math.min(body, 2.0 * baseTR)
float avgBody    = ta.sma(bodyClean, volLen)
float bodyFast   = ta.sma(bodyClean, 3)
float bodyShrink = avgBody > 0 ? clamp01(1.0 - bodyFast / avgBody) : 0.0
float upWr       = rng > 0 ? upperWick / rng : 0.0
float loWr       = rng > 0 ? lowerWick / rng : 0.0
float rejection  = ta.sma(upWr, 3)
float dips       = ta.sma(loWr, 3)
float fCandle    = 0.4 * bodyShrink + 0.35 * clamp01(rejection * 2.0) + 0.25 * clamp01(dips * 2.0)

// ───────────────────────────── FACTOR 4: VOLATILITY REGIME ──────────────────
float volS     = ta.sma(trClean, 5)
float volL     = ta.sma(trClean, volLen)
float volRatio = volL > 0 ? volS / volL : 1.0
float fComp    = clamp01((0.85 - volRatio) / 0.45)
float fExpand  = clamp01((volRatio - 1.2) / 1.0)
float fVol     = math.max(fComp, fExpand)

// ───────────────────────────── FACTOR 5: TICK VOLUME ────────────────────────
float vol       = nz(volume)
float cumVol    = ta.cum(vol)
bool  hasVolume = cumVol > 0
float volZ      = zScore(vol, volLen)
float fTick     = hasVolume ? clamp01((math.abs(volZ) - 0.5) / 2.5) : 0.0

// ───────────────────────────── FACTOR 6: SHORT-TERM STRUCTURE ───────────────
float hiN        = ta.highest(high, structLen)
float emaFast    = ta.ema(close, 9)
bool  failedHigh = not na(hiN[1]) and high[1] >= hiN[1] and high < high[1]
bool  breakLow   = close < low[1]
bool  belowFast  = close < emaFast
bool  lowerHigh  = high < high[1] and high[1] < high[2]
float fStruct    = 0.35 * (failedHigh ? 1.0 : 0.0) + 0.25 * (breakLow ? 1.0 : 0.0) + 0.2 * (belowFast ? 1.0 : 0.0) + 0.2 * (lowerHigh ? 1.0 : 0.0)

// ───────────────────────────── FACTOR 7: STRETCH / DISTANCE FROM HIGHS ──────
float stretchZ = zScore(close, structLen)
float distHigh = (nz(hiN, high) - close) / baseTR
float fDist    = 0.6 * clamp01((stretchZ - 1.0) / 1.5) + 0.4 * clamp01(1.0 - distHigh / 3.0)

// ───────────────────────────── FACTOR 8: ABNORMAL MOVEMENT ──────────────────
float chgZ = zScore(cleanChg, volLen)
float rngZ = zScore(trClean, volLen)
float fAbn = math.max(clamp01((math.abs(chgZ) - 1.5) / 2.0), clamp01((rngZ - 1.5) / 2.0))

// ───────────────────────────── FACTOR 9: STATISTICAL HAZARD ─────────────────
// Empirical hazard h(age) = P(spike this bar | bars since last spike).
// For a memoryless (random) process h(age) is flat, so this factor stays ~0.
// It only contributes if the chart's own history shows age-dependent risk.
const int AGE_BUCKETS = 20
var array<int> ageCnt = array.new<int>(AGE_BUCKETS, 0)
var array<int> ageHit = array.new<int>(AGE_BUCKETS, 0)
var int hazCnt = 0
var int hazHit = 0
int   ageBucket = ageBars > 0 ? math.min(AGE_BUCKETS - 1, math.floor((ageBars - 1) / hazBucket)) : -1
float pBar      = hazCnt > 0 ? float(hazHit) / hazCnt : na
float hazNow    = na
if ageBucket >= 0 and hazCnt > 0
    hazNow := (array.get(ageHit, ageBucket) + pBar * 200.0) / (array.get(ageCnt, ageBucket) + 200.0)
float hazRatio = pBar > 0 ? hazNow / pBar : na
float fStat    = clamp01(nz(hazRatio, 1.0) - 1.0)

// ───────────────────────────── FACTOR 10: MULTI-TIMEFRAME ───────────────────
float htfRaw   = request.security(syminfo.tickerid, htfTf, htfPressure()[1], lookahead = barmerge.lookahead_on)
bool  mtfValid = useMtf and timeframe.in_seconds(htfTf) > timeframe.in_seconds(timeframe.period)
float fMtf     = mtfValid ? clamp01(htfRaw) : 0.0

// ───────────────────────────── WEIGHTED COMPOSITE SCORE ─────────────────────
float wTickEff = hasVolume ? wTick : 0.0
float wMtfEff  = mtfValid ? wMtf : 0.0
float wSum     = wMom + wRun + wCandle + wVol + wTickEff + wStruct + wDist + wAbn + wStat + wMtfEff
float wTotal   = wMom * fMom + wRun * fRun + wCandle * fCandle + wVol * fVol + wTickEff * fTick + wStruct * fStruct + wDist * fDist + wAbn * fAbn + wStat * fStat + wMtfEff * fMtf
float rawScore = wSum > 0 ? wTotal / wSum : 0.0
float scoreIns = 100.0 * (1.0 - math.exp(-2.2 * detSens * rawScore))
float score    = ta.ema(scoreIns, smoothLen)

int aligned = (fMom >= factorOn ? 1 : 0) + (fRun >= factorOn ? 1 : 0) + (fCandle >= factorOn ? 1 : 0) + (fVol >= factorOn ? 1 : 0) + (hasVolume and fTick >= factorOn ? 1 : 0) + (fStruct >= factorOn ? 1 : 0) + (fDist >= factorOn ? 1 : 0) + (fAbn >= factorOn ? 1 : 0) + (fStat >= factorOn ? 1 : 0) + (mtfValid and fMtf >= factorOn ? 1 : 0)
int factorTotal = 8 + (hasVolume ? 1 : 0) + (mtfValid ? 1 : 0)

// ───────────────────────────── SIGNAL STATE MACHINE ─────────────────────────
float watchThr   = math.max(5.0, math.min(95.0, minProb / earlySens))
float redThr     = math.max(watchThr, float(redProb))
int   minAligned = math.max(1, math.round(minFactors / earlySens))

int state = 0      // 0 = GREEN, 1 = YELLOW (watch), 2 = RED (high alert)
if not spikeCond and not inCooldown and bar_index > volLen
    if score >= redThr and aligned >= minAligned
        state := 2
    else if score >= watchThr
        state := 1

int  prevState     = nz(state[1])                         // last CLOSED bar
bool watchStartAny = state >= 1 and prevState < 1         // entry into watch or higher
bool redStart      = state == 2 and prevState < 2
bool watchMarker   = watchStartAny and state == 1 and barstate.isconfirmed
bool redMarker     = redStart and barstate.isconfirmed

float watchActSum = math.sum(state >= 1 ? 1.0 : 0.0, evalWin)
bool  caught      = nz(watchActSum[1]) > 0                // warning active before spike

// ───────────────────────────── HISTORICAL EVALUATION ────────────────────────
[wWarn, wHit, wFalse, wLead, wDet, wMiss] = evalLevel(state >= 1, watchStartAny, spikeCond, evalWin)
[rWarn, rHit, rFalse, rLead, rDet, rMiss] = evalLevel(state == 2, redStart, spikeCond, evalWin)

// Score calibration: P(spike within evalWin bars | score decile), past data only
int   scoreBin    = math.min(9, math.max(0, math.floor(score / 10.0)))
float spikesInWin = math.sum(spikeInt, evalWin)
var array<int> binCnt = array.new<int>(10, 0)
var array<int> binHit = array.new<int>(10, 0)
var int calCnt = 0
var int calHit = 0
if barstate.isconfirmed and bar_index >= volLen + evalWin
    int  oldBin  = scoreBin[evalWin]
    bool outcome = spikesInWin > 0
    array.set(binCnt, oldBin, array.get(binCnt, oldBin) + 1)
    calCnt += 1
    if outcome
        array.set(binHit, oldBin, array.get(binHit, oldBin) + 1)
        calHit += 1

float baseRateN = calCnt > 0 ? float(calHit) / calCnt : na
float probN     = na
if calCnt > 0
    probN := (array.get(binHit, scoreBin) + baseRateN * 30.0) / (array.get(binCnt, scoreBin) + 30.0)
float geomBase  = na(pBar) ? na : 1.0 - math.pow(1.0 - pBar, evalWin)

// Hazard table update (uses this bar's age, before the spike memory changes)
if barstate.isconfirmed and ageBucket >= 0
    array.set(ageCnt, ageBucket, array.get(ageCnt, ageBucket) + 1)
    hazCnt += 1
    if spikeCond
        array.set(ageHit, ageBucket, array.get(ageHit, ageBucket) + 1)
        hazHit += 1

// Spike memory update (confirmed spikes only)
if spikeC
    if lastSpikeBar >= 0
        float iv = bar_index - lastSpikeBar
        intervalN   += 1
        intervalSum += iv
        intervalSq  += iv * iv
    lastSpikeBar  := bar_index
    lastSpikeTime := time
    lastSpikeSize := dropClose
    lastSpikeX    := dropClose / baseTR
    spikeCount    += 1

// ───────────────────────────── CHART SIGNALS ────────────────────────────────
color C_GREEN = #22C55E
color C_YEL   = #FACC15
color C_RED   = #EF4444
color C_SPK   = #A855F7
color C_TXT   = #E5E7EB
color C_DIM   = #9CA3AF
color C_BG    = color.new(#0E1117, 8)
color C_HDR   = color.new(#1F2937, 0)

plotshape(showWatch and watchMarker, "Spike Watch (confirmed)", shape.triangledown, location.abovebar, color.new(C_YEL, 0), text = "WATCH", textcolor = C_YEL, size = size.small)
plotshape(showAlert and redMarker, "High Spike Alert (confirmed)", shape.arrowdown, location.abovebar, color.new(C_RED, 0), text = "SPIKE ALERT", textcolor = C_RED, size = size.large)
plotshape(showSpike and spikeC and caught, "Confirmed spike (warned)", shape.labelup, location.belowbar, color.new(C_SPK, 10), text = "SPIKE ✓", textcolor = color.white, size = size.small)
plotshape(showSpike and spikeC and not caught, "Confirmed spike (not warned)", shape.labelup, location.belowbar, color.new(C_DIM, 20), text = "SPIKE", textcolor = color.white, size = size.small)

bgcolor(showBg ? (state == 2 ? color.new(C_RED, 88) : state == 1 ? color.new(C_YEL, 93) : na) : na, title = "Signal level background")

// Data-window outputs (not drawn on the price scale)
plot(score, "Detection Score", color = C_YEL, display = display.data_window)
plot(nz(probN) * 100.0, "Empirical P(spike in window) %", display = display.data_window)
plot(state, "Signal State (0/1/2)", display = display.data_window)
plot(aligned, "Aligned Factors", display = display.data_window)
plot(fMom * 100.0, "F1 Momentum", display = display.data_window)
plot(fRun * 100.0, "F2 Up-run", display = display.data_window)
plot(fCandle * 100.0, "F3 Candle", display = display.data_window)
plot(fVol * 100.0, "F4 Volatility", display = display.data_window)
plot(fTick * 100.0, "F5 Tick Volume", display = display.data_window)
plot(fStruct * 100.0, "F6 Structure", display = display.data_window)
plot(fDist * 100.0, "F7 Stretch", display = display.data_window)
plot(fAbn * 100.0, "F8 Abnormal", display = display.data_window)
plot(fStat * 100.0, "F9 Hazard", display = display.data_window)
plot(fMtf * 100.0, "F10 MTF", display = display.data_window)

// Provisional live-bar label (single reusable object, never left behind)
var label liveLbl = label.new(bar_index, high, "", yloc = yloc.abovebar, color = color(na), textcolor = color(na), style = label.style_label_down, size = size.normal)
if barstate.islast
    bool showIt = showLive and liveBar and (state >= 1 or spikeLive)
    if showIt
        string lt = spikeLive ? "SPIKE IN PROGRESS\n(live, unconfirmed)" : state == 2 ? "SPIKE ALERT?\n(live, provisional)" : "WATCH?\n(live, provisional)"
        color  lc = spikeLive ? color.new(C_SPK, 20) : state == 2 ? color.new(C_RED, 35) : color.new(C_YEL, 35)
        label.set_xy(liveLbl, bar_index, high)
        label.set_yloc(liveLbl, spikeLive ? yloc.belowbar : yloc.abovebar)
        label.set_style(liveLbl, spikeLive ? label.style_label_up : label.style_label_down)
        label.set_text(liveLbl, lt)
        label.set_color(liveLbl, lc)
        label.set_textcolor(liveLbl, state == 1 and not spikeLive ? color.black : color.white)
    else
        label.set_text(liveLbl, "")
        label.set_color(liveLbl, color(na))
        label.set_textcolor(liveLbl, color(na))

// ───────────────────────────── ALERTS ───────────────────────────────────────
// alertcondition(): choose "Once Per Bar Close" for confirmed signals,
// or "Once Per Bar" for the earliest provisional (live-bar) warning.
alertcondition(watchStartAny, "1. Potential spike developing", 'CRASH 1000 | SPIKE WATCH: potential spike developing on {{ticker}} {{interval}} | score {{plot("Detection Score")}} | price {{close}}')
alertcondition(redStart, "2. High-probability spike warning", 'CRASH 1000 | HIGH SPIKE ALERT on {{ticker}} {{interval}} | score {{plot("Detection Score")}} | price {{close}}')
alertcondition(spikeCond, "3. Confirmed downward spike", "CRASH 1000 | DOWNWARD SPIKE detected on {{ticker}} {{interval}} | close {{close}}")

bool   liveMode  = alertMode == "Live (provisional, earliest)"
string alertFreq = liveMode ? alert.freq_once_per_bar : alert.freq_once_per_bar_close
string tagTxt    = liveMode ? " [provisional]" : " [confirmed]"
if useAlertFn
    if alertWatch and watchStartAny and state == 1
        alert(str.format("CRASH 1000 SPIKE WATCH{0} | {1} {2} | score {3}/100 | factors {4}/{5} | price {6}", tagTxt, syminfo.ticker, timeframe.period, str.tostring(score, "0"), aligned, factorTotal, str.tostring(close, format.mintick)), alertFreq)
    if alertRed and redStart
        alert(str.format("CRASH 1000 HIGH SPIKE ALERT{0} | {1} {2} | score {3}/100 | factors {4}/{5} | price {6}", tagTxt, syminfo.ticker, timeframe.period, str.tostring(score, "0"), aligned, factorTotal, str.tostring(close, format.mintick)), alertFreq)
    if alertSpike and (liveMode ? spikeTouch : spikeCond)
        alert(str.format("CRASH 1000 DOWNWARD SPIKE{0} | {1} {2} | drop {3} pts ({4}x baseline) | price {5}", tagTxt, syminfo.ticker, timeframe.period, str.tostring(liveMode ? dropLow : dropClose, format.mintick), str.tostring((liveMode ? dropLow : dropClose) / baseTR, "0.0"), str.tostring(close, format.mintick)), alertFreq)

// ───────────────────────────── DASHBOARD ────────────────────────────────────
string dashPos = switch dashPosIn
    "Top Left"     => position.top_left
    "Bottom Right" => position.bottom_right
    "Bottom Left"  => position.bottom_left
    "Middle Right" => position.middle_right
    => position.top_right
string dashSz = switch dashSzIn
    "Tiny"   => size.tiny
    "Normal" => size.normal
    => size.small

var table dash = table.new(dashPos, 3, 28, bgcolor = C_BG, frame_color = color.new(#374151, 0), frame_width = 1, border_color = color.new(#374151, 40), border_width = 1)

setCell(int c, int r, string txt, color tc, color bg) =>
    table.cell(dash, c, r, txt, text_color = tc, bgcolor = bg, text_size = dashSz, text_halign = text.align_left)

if barstate.isfirst
    table.merge_cells(dash, 0, 0, 2, 0)
    table.merge_cells(dash, 0, 15, 2, 15)
    table.merge_cells(dash, 0, 27, 2, 27)

if showDash and barstate.islast
    color  stCol  = state == 2 ? C_RED : state == 1 ? C_YEL : C_GREEN
    string stTxt  = state == 2 ? "RED — HIGH SPIKE ALERT" : state == 1 ? "YELLOW — SPIKE WATCH" : "GREEN — NORMAL"
    string modeTx = liveBar ? "provisional (live bar)" : "confirmed (closed bar)"
    int    gauge  = math.max(0, math.min(10, math.round(score / 10.0)))
    string gTxt   = str.repeat("█", gauge) + str.repeat("░", 10 - gauge)

    string condTx = spikeLive or (liveBar and spikeCond) ? "SPIKE IN PROGRESS" : spikeCond ? "Spike bar" : inCooldown ? "Post-spike reset" : state == 2 ? "Exhaustion — high risk" : state == 1 ? "Pressure building" : fComp > 0.5 ? "Compressed drift" : fExpand > 0.5 ? "Volatile drift" : "Normal upward drift"
    string momTx  = rocZ > 1.5 ? "Stretched / overextended" : decel > 0.5 ? "Decelerating (exhaustion)" : velSlow > 0 ? "Rising (normal drift)" : "Weak / falling"
    color  momCol = rocZ > 1.5 or decel > 0.5 ? C_YEL : velSlow > 0 ? C_GREEN : C_DIM
    string volTx  = volRatio < 0.85 ? "Compressed" : volRatio > 1.2 ? "Expanding" : "Normal"
    color  volCol = volRatio < 0.85 or volRatio > 1.2 ? C_YEL : C_GREEN

    // top two drivers
    array<float>  fv = array.from(fMom, fRun, fCandle, fVol, fTick, fStruct, fDist, fAbn, fStat, fMtf)
    array<string> fn = array.from("Momentum", "Up-run", "Candles", "Volatility", "Tick vol", "Structure", "Stretch", "Abnormal", "Hazard", "MTF")
    int   i1 = 0
    int   i2 = 1
    float b1 = -1.0
    float b2 = -1.0
    for i = 0 to 9
        float v = array.get(fv, i)
        if v > b1
            b2 := b1
            i2 := i1
            b1 := v
            i1 := i
        else if v > b2
            b2 := v
            i2 := i
    string drvTx = array.get(fn, i1) + " " + str.tostring(b1 * 100.0, "0") + " · " + array.get(fn, i2) + " " + str.tostring(b2 * 100.0, "0")

    string lsTime = lastSpikeBar >= 0 ? str.format_time(lastSpikeTime, "yyyy-MM-dd HH:mm", syminfo.timezone) : "none in history"
    string lsAgo  = lastSpikeBar >= 0 ? str.tostring(bar_index - lastSpikeBar) + " bars ago" : "—"
    string lsSize = lastSpikeBar >= 0 ? str.tostring(lastSpikeSize, format.mintick) + " pts" : "—"
    string lsX    = lastSpikeBar >= 0 ? str.tostring(lastSpikeX, "0.0") + "x baseline" : "—"

    float ivMean = intervalN > 0 ? intervalSum / intervalN : na
    float ivSd   = intervalN > 1 ? math.sqrt(math.max(0.0, intervalSq / intervalN - ivMean * ivMean)) : na
    float ivCv   = not na(ivMean) and ivMean > 0 and not na(ivSd) ? ivSd / ivMean : na

    string tfTx  = timeframe.period + (timeframe.isminutes ? "m" : "")
    string mtfTx = mtfValid ? "MTF " + htfTf : "MTF off"

    setCell(0, 0, "CRASH 1000 SPIKE EARLY-WARNING", C_TXT, C_HDR)
    setCell(0, 1, "Spike score", C_DIM, na)
    setCell(1, 1, str.tostring(score, "0") + " / 100", stCol, na)
    setCell(2, 1, gTxt, stCol, na)
    setCell(0, 2, "P(spike ≤ " + str.tostring(evalWin) + " bars)", C_DIM, na)
    setCell(1, 2, pct(probN), C_TXT, na)
    setCell(2, 2, "base " + pct(baseRateN), C_DIM, na)
    setCell(0, 3, "Signal level", C_DIM, na)
    setCell(1, 3, stTxt, color.black, stCol)
    setCell(2, 3, modeTx, C_DIM, na)
    setCell(0, 4, "Market condition", C_DIM, na)
    setCell(1, 4, condTx, C_TXT, na)
    setCell(2, 4, "thr " + str.tostring(watchThr, "0") + " / " + str.tostring(redThr, "0"), C_DIM, na)
    setCell(0, 5, "Spike Watch", C_DIM, na)
    setCell(1, 5, state >= 1 ? "ACTIVE" : "off", state >= 1 ? C_YEL : C_DIM, na)
    setCell(2, 5, "last close: " + (prevState >= 1 ? "ON" : "off"), C_DIM, na)
    setCell(0, 6, "High Spike Alert", C_DIM, na)
    setCell(1, 6, state == 2 ? "ACTIVE" : "off", state == 2 ? C_RED : C_DIM, na)
    setCell(2, 6, "last close: " + (prevState == 2 ? "ON" : "off"), C_DIM, na)
    setCell(0, 7, "Momentum", C_DIM, na)
    setCell(1, 7, momTx, momCol, na)
    setCell(2, 7, "z " + str.tostring(rocZ, "0.00"), C_DIM, na)
    setCell(0, 8, "Volatility", C_DIM, na)
    setCell(1, 8, volTx, volCol, na)
    setCell(2, 8, "ratio " + str.tostring(volRatio, "0.00"), C_DIM, na)
    setCell(0, 9, "Aligned factors", C_DIM, na)
    setCell(1, 9, str.tostring(aligned) + " / " + str.tostring(factorTotal), aligned >= minAligned ? C_RED : C_TXT, na)
    setCell(2, 9, drvTx, C_DIM, na)
    setCell(0, 10, "Last spike", C_DIM, na)
    setCell(1, 10, lsTime, C_SPK, na)
    setCell(2, 10, lsAgo, C_DIM, na)
    setCell(0, 11, "Last spike size", C_DIM, na)
    setCell(1, 11, lsSize, C_TXT, na)
    setCell(2, 11, lsX, C_DIM, na)
    setCell(0, 12, "Mean spike interval", C_DIM, na)
    setCell(1, 12, num(ivMean, "0.0") + " bars", C_TXT, na)
    setCell(2, 12, "CV " + num(ivCv, "0.00") + " (≈1 = random)", C_DIM, na)
    setCell(0, 13, "Detection timeframe", C_DIM, na)
    setCell(1, 13, tfTx, C_TXT, na)
    setCell(2, 13, mtfTx + (hasVolume ? " · tick vol ON" : " · no volume"), C_DIM, na)
    setCell(0, 14, "Hazard vs average", C_DIM, na)
    setCell(1, 14, num(hazRatio, "0.00") + "x", C_TXT, na)
    setCell(2, 14, "per-bar p " + pct(pBar), C_DIM, na)

    if showEval
        float wPrec = wHit + wFalse > 0 ? float(wHit) / (wHit + wFalse) : na
        float rPrec = rHit + rFalse > 0 ? float(rHit) / (rHit + rFalse) : na
        float wRec  = wDet + wMiss > 0 ? float(wDet) / (wDet + wMiss) : na
        float rRec  = rDet + rMiss > 0 ? float(rDet) / (rDet + rMiss) : na
        float wLd   = wHit > 0 ? wLead / wHit : na
        float rLd   = rHit > 0 ? rLead / rHit : na
        float tfMin = timeframe.in_seconds(timeframe.period) / 60.0
        float wLift = not na(wPrec) and baseRateN > 0 ? wPrec / baseRateN : na
        float rLift = not na(rPrec) and baseRateN > 0 ? rPrec / baseRateN : na

        setCell(0, 15, "HISTORICAL EVALUATION  (window " + str.tostring(evalWin) + " bars, loaded history)", C_TXT, C_HDR)
        setCell(0, 16, "Metric", C_DIM, C_HDR)
        setCell(1, 16, "WATCH+", C_YEL, C_HDR)
        setCell(2, 16, "RED", C_RED, C_HDR)
        setCell(0, 17, "Confirmed spikes", C_DIM, na)
        setCell(1, 17, str.tostring(spikeCount), C_TXT, na)
        setCell(2, 17, "theory base " + pct(geomBase), C_DIM, na)
        setCell(0, 18, "Warnings resolved", C_DIM, na)
        setCell(1, 18, str.tostring(wHit + wFalse), C_TXT, na)
        setCell(2, 18, str.tostring(rHit + rFalse), C_TXT, na)
        setCell(0, 19, "Followed by spike", C_DIM, na)
        setCell(1, 19, str.tostring(wHit), C_GREEN, na)
        setCell(2, 19, str.tostring(rHit), C_GREEN, na)
        setCell(0, 20, "No spike (false)", C_DIM, na)
        setCell(1, 20, str.tostring(wFalse), C_RED, na)
        setCell(2, 20, str.tostring(rFalse), C_RED, na)
        setCell(0, 21, "Precision", C_DIM, na)
        setCell(1, 21, pct(wPrec), C_TXT, na)
        setCell(2, 21, pct(rPrec), C_TXT, na)
        setCell(0, 22, "Spikes caught (recall)", C_DIM, na)
        setCell(1, 22, pct(wRec) + " (" + str.tostring(wDet) + ")", C_TXT, na)
        setCell(2, 22, pct(rRec) + " (" + str.tostring(rDet) + ")", C_TXT, na)
        setCell(0, 23, "Missed spikes", C_DIM, na)
        setCell(1, 23, str.tostring(wMiss), C_TXT, na)
        setCell(2, 23, str.tostring(rMiss), C_TXT, na)
        setCell(0, 24, "Avg lead time", C_DIM, na)
        setCell(1, 24, num(wLd, "0.0") + " bars / " + num(na(wLd) ? na : wLd * tfMin, "0.0") + " min", C_TXT, na)
        setCell(2, 24, num(rLd, "0.0") + " bars / " + num(na(rLd) ? na : rLd * tfMin, "0.0") + " min", C_TXT, na)
        setCell(0, 25, "Lift vs random", C_DIM, na)
        setCell(1, 25, num(wLift, "0.00") + "x", not na(wLift) and wLift > 1.1 ? C_GREEN : C_TXT, na)
        setCell(2, 25, num(rLift, "0.00") + "x", not na(rLift) and rLift > 1.1 ? C_GREEN : C_TXT, na)
        setCell(0, 26, "Detection accuracy", C_DIM, na)
        setCell(1, 26, "F1 " + num(not na(wPrec) and not na(wRec) and wPrec + wRec > 0 ? 2.0 * wPrec * wRec / (wPrec + wRec) : na, "0.00"), C_TXT, na)
        setCell(2, 26, "F1 " + num(not na(rPrec) and not na(rRec) and rPrec + rRec > 0 ? 2.0 * rPrec * rRec / (rPrec + rRec) : na, "0.00"), C_TXT, na)
        setCell(0, 27, "Lift ≈ 1.0 means no edge over random timing. Measured on this chart's loaded bars only.", C_DIM, na)
